    "test": "pnpm build && node --test test/*.test.js"
  },
  "devDependencies": {
    "astro": "7.4.1",
    "wrangler": "4.134.0"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.25.0",
  "description": " Traditional Chinese fork with a converted interface and article text.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dogbro2/wikiscroll-zh.git"
  },
  "homepage": "https://github.com/dogbro2/wikiscroll-zh#readme",
