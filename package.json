{
  "name": "wikiscroll-zh",
  "version": "2.1.0-zhhant.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "check": "node --check public/app.js && node --check public/atlas.js && node --check worker/index.js && pnpm test",
    "deploy": "bash scripts/deploy.sh",
