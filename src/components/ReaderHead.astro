---
import readerStyles from "../styles/reader.css?url";

// Deployment values. Set PUBLIC_SITE_ORIGIN, PUBLIC_CARDS_ORIGIN and
// PUBLIC_CONTACT_EMAIL at build time; see README. Nothing here defaults to
// another site's domain, and an unset site origin simply omits canonical URLs.
const SITE = (import.meta.env.PUBLIC_SITE_ORIGIN || Astro.site?.origin || '').replace(/\/+$/, '');
const CARDS = (import.meta.env.PUBLIC_CARDS_ORIGIN || '').replace(/\/+$/, '');
const CONTACT = import.meta.env.PUBLIC_CONTACT_EMAIL || '';
const REPO = import.meta.env.PUBLIC_REPO_URL || '';
const share = path => SITE ? SITE + path : path;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "WikiScroll",
  "alternateName": "WikiScroll: Random Wikipedia Reader",
  ...(SITE ? {"url": SITE} : {}),
  "description": "Turn doomscrolling into mindful discovery. Explore surprising Wikipedia knowledge and Wikivoyage destinations, save what matters, and learn at your own pace.",
  "applicationCategory": "EducationalApplication",
  "applicationSubCategory": "Knowledge Discovery",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
  "author": { "@type": "Organization", "name": "WikiScroll", ...(SITE ? {"url": SITE} : {}) },
  "publisher": { "@type": "Organization", "name": "WikiScroll", ...(SITE ? {"url": SITE} : {}), "logo": { "@type": "ImageObject", "url": SITE ? SITE + "/images/icon-512.png" : "/images/icon-512.png" } },
  "browserRequirements": "Requires JavaScript. Works in Chrome, Firefox, Safari, Edge.",
  "softwareVersion": "2.1.0",
  "image": share("/images/og-discovery-v12.png"),
  "featureList": "Mindful discovery of Wikipedia articles, Wikivoyage travel guides, 15 languages, 12 topic categories, swipe gestures, ambient reading mode, offline support, reading history, collections, share with rich link previews, interactive map explorer, article depth slider, keyboard shortcuts, Progressive Web App",
  "keywords": "Wikipedia, Wikivoyage, mindful reading, random articles, learning, discovery, knowledge, educational app, PWA, mindful discovery",
  "inLanguage": ["en","es","fr","de","it","pt","ru","ja","zh","ar","hi","ko","he","nl","pl"],
  "isAccessibleForFree": true,
  "permissions": "no special permissions required",
  "isBasedOn": "https://github.com/Golps/WikiScroll"
};
---
<meta name="ws-site-origin" content={SITE}>
<meta name="ws-cards-origin" content={CARDS}>
<meta name="ws-contact-email" content={CONTACT}>

<meta name="carto-basemap-key" content="">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
<title>WikiScroll</title>
<meta name="description" content="Turn doomscrolling into mindful discovery. Explore surprising Wikipedia knowledge and Wikivoyage destinations, save what matters, and learn at your own pace.">
<meta name="keywords" content="Wikipedia reader, Wikivoyage, mindful reading, random Wikipedia articles, learn something new, mindful discovery, Wikipedia app, educational app, knowledge discovery, free learning, random knowledge, Wikipedia browser, travel articles">
<meta name="author" content="WikiScroll">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1">
<meta name="bingbot" content="index, follow">
{SITE && <link rel="canonical" href={`${SITE}/`} />}
<meta name="theme-color" content="#101418" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="color-scheme" content="dark light">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="WikiScroll">
<meta name="application-name" content="WikiScroll">
<meta name="mobile-web-app-capable" content="yes">
<meta name="format-detection" content="telephone=no">
<link rel="icon" href="/images/favicon.ico?v=42" sizes="32x32">
<link rel="manifest" href="/manifest.json">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png?v=42">
<link rel="icon" type="image/png" sizes="192x192" href="/images/icon-192.png?v=42">
<link rel="icon" type="image/png" sizes="512x512" href="/images/icon-512.png?v=42">

<!-- Open Graph -->
<meta property="og:type" content="website">
{SITE && <meta property="og:url" content={`${SITE}/`} />}
<meta property="og:title" content="WikiScroll: Replace doomscrolling with discovery">
<meta property="og:description" content="Turn doomscrolling into mindful discovery. Explore surprising Wikipedia knowledge and Wikivoyage destinations, save what matters, and learn at your own pace.">
<meta property="og:image" content={share("/images/og-discovery-v12.png")}>
<meta property="og:image:width" content="1731">
<meta property="og:image:height" content="909">
<meta property="og:image:alt" content="WikiScroll: Replace doomscrolling with discovery">
<meta property="og:site_name" content="WikiScroll">
<meta property="og:locale" content="en_US">
<meta property="og:locale:alternate" content="es_ES">
<meta property="og:locale:alternate" content="fr_FR">
<meta property="og:locale:alternate" content="de_DE">
<meta property="og:locale:alternate" content="ja_JP">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="WikiScroll: Replace doomscrolling with discovery">
<meta name="twitter:description" content="Turn doomscrolling into mindful discovery. Explore surprising Wikipedia knowledge and Wikivoyage destinations, save what matters, and learn at your own pace.">
<meta name="twitter:image" content={share("/images/og-discovery-v12.png")}>
<meta name="twitter:image:alt" content="WikiScroll: Replace doomscrolling with discovery">


<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />



<link rel="preconnect" href="https://thumb.wikimedia.org">
<link rel="preconnect" href="https://upload.wikimedia.org">
<link rel="stylesheet" href={readerStyles}>
<script is:inline src="/lang.js?v=20"></script>
<link rel="stylesheet" href="/about.css?v=51">
<link rel="describedby" href="/llms.txt" type="text/plain">
